          "datasource": {
            "type": "mysql",
            "uid": "ws-glpi"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ROUND(AVG(s.satisfaction),2) AS csat FROM glpi_ticketsatisfactions s\nWHERE s.date_answered >= NOW() - INTERVAL 30 DAY"
