          "rawSql": "SELECT ROUND(100*SUM(s.date_answered IS NOT NULL)/NULLIF(COUNT(*),0),1) AS response_rate\nFROM glpi_ticketsatisfactions s WHERE s.date_begin >= NOW() - INTERVAL 30 DAY"
