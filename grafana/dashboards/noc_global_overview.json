      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:18px;height:100%\"><img src=\"/public/img/wisesphere/logo.svg\" alt=\"WISE Group\" style=\"height:54px\"/><span style=\"font-size:26px;color:#424242\">Wise<b style=\"color:#dc552d\">Sphere</b></span><span style=\"margin-inline-start:auto;color:#777777;text-transform:uppercase;letter-spacing:.1em;font-weight:700\">NOC Global Overview</span></div>"
      }
    },
    {
      "id": 1,
      "title": "Global Health Matrix (DSH-01)",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "ws-glpi"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ws-glpi"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT e.tag AS client, e.name AS name,\n  COALESCE(SUM(t.is_deleted=0 AND t.status NOT IN (5,6) AND t.priority>=5),0) AS open_p1,\n  COALESCE(SUM(t.is_deleted=0 AND t.status NOT IN (5,6) AND t.priority=4),0) AS open_p2,\n  COALESCE(SUM(t.is_deleted=0 AND t.status NOT IN (5,6) AND t.time_to_resolve < NOW()),0) AS sla_breached,\n  COALESCE(SUM(t.is_deleted=0 AND t.status NOT IN (5,6) AND t.name LIKE '[STORM:%'),0) AS storms,\n  CASE WHEN SUM(t.is_deleted=0 AND t.status NOT IN (5,6) AND (t.priority>=5 OR t.time_to_resolve < NOW()))>0 THEN 'RED'\n       WHEN SUM(t.is_deleted=0 AND t.status NOT IN (5,6) AND t.priority=4)>0 THEN 'AMBER' ELSE 'GREEN' END AS status\nFROM glpi_entities e LEFT JOIN glpi_tickets t ON t.entities_id=e.id\nWHERE e.tag LIKE 'CL%'\nGROUP BY e.id, e.tag, e.name ORDER BY FIELD(status,'RED','AMBER','GREEN'), e.tag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RED": {
                        "color": "#b20000",
                        "index": 0
                      },
                      "AMBER": {
                        "color": "#e08a00",
                        "index": 1
                      },
                      "GREEN": {
                        "color": "#7a9c59",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Automated intake – 30 d (goal ≥ 90%)",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "ws-glpi"
      },
      "gridPos": {
        "x": 14,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ws-glpi"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ROUND(100*SUM(r.name IN ('Monitoring','Security'))/NULLIF(COUNT(*),0),1) AS automated\nFROM glpi_tickets t LEFT JOIN glpi_requesttypes r ON r.id=t.requesttypes_id\nWHERE t.is_deleted=0 AND t.date >= NOW() - INTERVAL 30 DAY"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#b20000",
                "value": null
              },
              {
                "color": "#e08a00",
                "value": 80
              },
              {
                "color": "#7a9c59",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "P1/P2 within SLA – 30 d (goal ≥ 95%)",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "ws-glpi"
      },
      "gridPos": {
        "x": 19,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ws-glpi"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ROUND(100*SUM(t.time_to_resolve IS NULL OR t.solvedate <= t.time_to_resolve)/NULLIF(COUNT(*),0),1) AS sla_ok\nFROM glpi_tickets t WHERE t.is_deleted=0 AND t.priority>=4 AND t.solvedate >= NOW() - INTERVAL 30 DAY"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#b20000",
                "value": null
              },
              {
                "color": "#e08a00",
                "value": 90
              },
              {
                "color": "#7a9c59",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "CSAT – 30 d (goal ≥ 4.3)",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "ws-glpi"
      },
      "gridPos": {
        "x": 14,
        "y": 8,
        "w": 5,
