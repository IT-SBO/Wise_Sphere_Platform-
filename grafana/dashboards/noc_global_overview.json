    {
      "id": 7,
      "title": "SLA countdown – open tickets nearest to breach (DSH-03)",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "ws-glpi"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "ws-glpi"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t.id AS ticket, e.tag AS client, t.priority, LEFT(t.name,90) AS title,\n  t.time_to_resolve AS due, TIMESTAMPDIFF(MINUTE, NOW(), t.time_to_resolve) AS minutes_left\nFROM glpi_tickets t JOIN glpi_entities e ON e.id=t.entities_id\nWHERE t.is_deleted=0 AND t.status NOT IN (5,6) AND t.time_to_resolve IS NOT NULL\nORDER BY t.time_to_resolve ASC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "minutes_left"
            },
            "properties": [
