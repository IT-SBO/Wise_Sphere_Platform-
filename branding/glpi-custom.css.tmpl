/* WiseSphere brand layer for GLPI 11 (generated by branding/apply_branding.py - do not edit in GLPI).
   Applied as custom CSS on the root entity and inherited by every client entity (client portal). */
:root, [data-bs-theme] {
  --tblr-primary: {{primary}};
  --tblr-primary-rgb: {{primary_rgb}};
  --tblr-primary-fg: {{primary_contrast}};
  --tblr-danger: {{danger}};
  --tblr-warning: {{warning}};
  --tblr-success: {{success}};
  --tblr-body-color: {{text}};
  --tblr-font-sans-serif: {{font_family}};
}
html[dir="rtl"], html[lang^="ar"] { --tblr-font-sans-serif: {{font_family_arabic}}; }
.btn-primary { background-color: {{primary}}; border-color: {{primary}}; color: {{primary_contrast}}; }
a { color: {{primary}}; }
