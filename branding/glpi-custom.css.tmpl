/* WiseSphere brand layer for GLPI 11 - WISE Group style (https://wisegroup.trade).
   Generated by branding/apply_branding.py from branding/tokens.json - do not edit in GLPI.
   Applied as custom CSS on the root entity (also used by the login page) and inherited by every client entity.
   Fonts and logos are files served by GLPI from /wisesphere/ (glpi/branding/ mounted into the container);
   without them GLPI falls back to system fonts and its own logo, nothing breaks. */
@font-face { font-family: 'Cairo'; font-weight: 400; font-display: swap; src: url('/wisesphere/cairo-latin-400.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
@font-face { font-family: 'Cairo'; font-weight: 700; font-display: swap; src: url('/wisesphere/cairo-latin-700.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
@font-face { font-family: 'Cairo'; font-weight: 400; font-display: swap; src: url('/wisesphere/cairo-arabic-400.woff2') format('woff2'); unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC; }
@font-face { font-family: 'Cairo'; font-weight: 700; font-display: swap; src: url('/wisesphere/cairo-arabic-700.woff2') format('woff2'); unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC; }

/* ---- colours (every light GLPI palette; users on a dark palette keep it) */
:root[data-glpi-theme][data-glpi-theme-dark="0"] {
  --tblr-primary: {{primary}};
  --tblr-primary-rgb: {{primary_rgb}};
  --tblr-primary-fg: {{primary_contrast}};
  --tblr-primary-darken: {{primary_dark}};
  --tblr-link-color: {{primary}};
  --tblr-link-color-rgb: {{primary_rgb}};
  --tblr-link-hover-color: {{primary_dark}};
  --tblr-danger: {{danger}};
  --tblr-warning: {{warning}};
  --tblr-success: {{success}};
  --tblr-body-color: {{text}};
  --tblr-body-bg: {{surface}};
  --tblr-border-radius: {{radius}};
  --tblr-border-radius-sm: {{radius}};
  --tblr-border-radius-lg: {{radius}};
  --glpi-mainmenu-bg: {{text}};
  --glpi-mainmenu-fg: #f2f2f2;
  --glpi-mainmenu-fg-muted: #f2f2f2a6;
  --glpi-mainmenu-active-bg: {{accent}};
  --glpi-helpdesk-header: #f6e1da;
  --glpi-form-header-fg: {{primary_dark}};
  --glpi-palette-color-1: {{primary}};
  --glpi-palette-color-2: {{accent}};
  --glpi-palette-color-3: {{primary_dark}};
  --glpi-palette-color-4: #fff;
  --glpi-illustrations-gradient-1: #fbe9e3;
  --glpi-illustrations-gradient-2: #ec9a80;
  --glpi-illustrations-gradient-3: {{primary}};
}
:root[data-glpi-theme] {
  --tblr-font-sans-serif: {{font_family}};
  --glpi-logo: url('/wisesphere/logo-light.svg');
  --glpi-logo-reduced: url('/wisesphere/logo-light.svg');
  --glpi-logo-dark: url('/wisesphere/logo.svg');
  --glpi-logo-dark-reduced: url('/wisesphere/logo.svg');
  --glpi-logo-dark-login: url('/wisesphere/logo.svg');
  --glpi-logo-light-login: url('/wisesphere/logo-light.svg');
}
html[dir="rtl"], html[lang^="ar"] { --tblr-font-sans-serif: {{font_family_arabic}}; }
body { font-family: var(--tblr-font-sans-serif); }

/* ---- logo: WiSE GROUP is wider than the GLPI mark */
.page .glpi-logo { background-size: contain !important; background-position: center !important; width: 110px; height: 60px; }
.sidebar .navbar-brand { padding-block: .9rem; }
body.navbar-collapsed .sidebar .glpi-logo { width: 46px; height: 40px; }
.page-anonymous .glpi-logo { width: 240px; height: 132px; object-fit: contain; }

/* ---- main menu: dark bar, orange marker on the active entry (like the site navigation) */
.sidebar { border-inline-end: 4px solid {{primary}}; }
.sidebar .nav-link { font-weight: 600; }
.sidebar .nav-item.active > .nav-link, .sidebar .nav-link.active,
.sidebar .dropdown-item.active, .sidebar .dropdown-item:active { box-shadow: inset 4px 0 0 {{primary}}; }
html[dir="rtl"] .sidebar .nav-item.active > .nav-link, html[dir="rtl"] .sidebar .nav-link.active,
html[dir="rtl"] .sidebar .dropdown-item.active { box-shadow: inset -4px 0 0 {{primary}}; }
.sidebar .nav-item.active > .nav-link .nav-link-icon, .sidebar .nav-link.active .nav-link-icon,
.sidebar .dropdown-item.active i { color: {{primary}} !important; }

/* ---- top bar: white with a thin orange line */
header.navbar[data-testid="main-header"] { border-bottom: 3px solid {{primary}}; }
.breadcrumb a { --tblr-breadcrumb-link-color: {{accent}}; font-weight: 600; }

/* ---- headings, buttons, forms */
h1, h2, h3, .card-title, .page-title { color: {{heading}}; font-weight: 700; }
.btn { border-radius: {{radius}}; font-weight: 700; }
.btn-primary { background-color: {{primary}} !important; border-color: {{primary}} !important; color: {{primary_contrast}} !important; }
.btn-primary:hover, .btn-primary:focus { background-color: {{primary_dark}} !important; border-color: {{primary_dark}} !important; }
.btn-outline-primary { color: {{primary}}; border-color: {{primary}}; }
.btn-outline-primary:hover { background-color: {{primary}}; color: {{primary_contrast}}; }
.btn-secondary, .btn-outline-secondary { border-color: {{accent}}; }
.form-control:focus, .form-select:focus { border-color: {{primary}}; box-shadow: 0 0 0 .2rem rgba({{primary_rgb}}, .2); }
.form-check-input:checked { background-color: {{primary}}; border-color: {{primary}}; }
.nav-tabs .nav-link.active { border-top: 3px solid {{primary}}; }
.card { border-radius: {{radius}}; }
.search-results thead th, table.table thead th { color: {{heading}}; font-weight: 700; }
a:not(.btn):not(.nav-link):not(.dropdown-item) { color: {{primary}}; }
a:not(.btn):not(.nav-link):not(.dropdown-item):hover { color: {{primary_dark}}; }

/* ---- sign-in page: dark brand background, white card with orange top edge */
body.welcome-anonymous, .page-anonymous {
  background:
    linear-gradient(135deg, rgba(37, 34, 35, .96) 0%, rgba(37, 34, 35, .86) 60%, rgba({{primary_rgb}}, .85) 150%),
    {{text}} !important;
}
.page-anonymous .main-content-card, .page-anonymous .card { border-top: 4px solid {{primary}}; box-shadow: 0 10px 30px rgba(0, 0, 0, .35); }
.page-anonymous .glpi-logo { --logo: var(--glpi-logo-light-login); }
.page-anonymous .card .glpi-logo { --logo: var(--glpi-logo-dark-login); }
.page-anonymous .card-title, .page-anonymous h2 { color: {{heading}}; }
.page-anonymous .copyright, .page-anonymous footer, .page-anonymous .text-center a { color: #cfcfcf !important; }
{{logo_css}}
