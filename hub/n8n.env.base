# Non-secret n8n settings for the hub. Render hub/n8n.env with:
#   python3 scripts/render_n8n_env.py --ids hub/glpi-ids.json --base hub/n8n.env.base --out hub/n8n.env
WS_GLPI_API_URL=http://glpi/apirest.php
# SMS provider endpoint (decision D-04). Must accept JSON {to, message}; adapt WF SMS node if not.
WS_SMS_URL=https://sms.example.com/api/send
WS_STORM_THRESHOLD=10
WS_STORM_WINDOW_MIN=5
WS_WAZUH_TICKET_LEVEL=10
WS_WAZUH_PAGE_LEVEL=12
WS_CSAT_LOW_SCORE=2
# On-call numbers come from the rota (SOP-05). E.164 format.
WS_ONCALL_NOC=
WS_ONCALL_SOC=
WS_DESK_PHONE=
WS_ONCALL_INTEGRATION=
