# WiseSphere HUB settings. Copy to hub/.env (chmod 600). Secrets come from the vault (NFR-SEC-04).
TZ=Asia/Kuwait
BRAND_NAME=WiseSphere

# ---- pinned versions (NFR-OPS-03, T-06). Upgrade on staging first (SOP-13).
TRAEFIK_TAG=v3.7.19
GLPI_TAG=11.0.13
MARIADB_TAG=11.8.9
POSTGRES_TAG=17.12-alpine
TIMESCALEDB_TAG=2.32.1-pg17
ZABBIX_TAG=alpine-8.0.0
N8N_TAG=2.49.3
GRAFANA_TAG=13.2.6
GRAFANA_PLUGINS=alexanderzobnin-zabbix-app

# ---- names
GLPI_HOST=support.example.com
GRAFANA_HOST=dashboards.example.com
ZABBIX_HOST=zabbix.internal.example.com
N8N_HOST=n8n.internal.example.com
ACME_EMAIL=noc@example.com

# ---- networks
# Docker backend network; also the source range of the GLPI "n8n" API client
BACKEND_SUBNET=172.31.0.0/24
# Hub WireGuard address on the host interface wg0 (ops/wg-hub-setup.sh). Spokes use 10.250.<n>.0/24.
WG_HUB_IP=10.250.0.1
WG_PORT=51820
# Staff VPN range ONLY - never 10.250.0.0/16 (T-03). Comma separated.
STAFF_CIDRS=10.99.0.0/24
# Hosts allowed to call n8n webhooks through Traefik: Zabbix server (HUB-ZBX-01) and Wazuh manager (HUB-WZH-01)
WEBHOOK_SOURCE_CIDRS=10.10.0.12/32,10.10.0.13/32
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php

# ---- secrets (generate with: openssl rand -base64 32)
GLPI_DB_ROOT_PASSWORD=
GLPI_DB_PASSWORD=
GLPI_DB_RO_PASSWORD=
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
ZABBIX_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
ZABBIX_GRAFANA_TOKEN=
WS_WEBHOOK_SECRET=
WS_GLPI_APP_TOKEN=
WS_GLPI_SVC_PASSWORD=
SMS_KEY=
# Backups (ops/backup-hub.sh) - restic repository off-site, encrypted (C-06)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
