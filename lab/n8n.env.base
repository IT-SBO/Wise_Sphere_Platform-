WS_STORM_THRESHOLD=10
WS_STORM_WINDOW_MIN=5
WS_WAZUH_TICKET_LEVEL=10
WS_WAZUH_PAGE_LEVEL=12
WS_CSAT_LOW_SCORE=2
# On-call numbers (lab placeholders). Production: from the on-call rota (SOP-05).
