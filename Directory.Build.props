<Project>
  <!-- Shared settings for every WiseSphere .NET project -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1848/CA1873: LoggerMessage source generators are nice-to-have, not required for this service -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1062;CA2007;CA1031;CA1515;CA1056;CA1054;CA1002;CA2227;CA1819;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1865;CA1866;CA1308</NoWarn>
  </PropertyGroup>
</Project>
